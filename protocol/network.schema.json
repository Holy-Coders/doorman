              "pattern": "^pattern_\\d+$"
            },
            "target": {
              "type": "string",
              "enum": [
                "assistant",
                "abuse"
              ]
            },
            "predicates": {
              "minItems": 2,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "feature": {
