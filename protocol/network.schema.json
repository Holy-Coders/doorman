    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "evaluatorVersion": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ]
      },
      "providerModel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "risk": {
        "type": "object",
        "properties": {
          "automation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "suspicious": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "automation",
          "suspicious"
        ],
        "additionalProperties": false
      },
      "riskStatus": {
        "type": "string",
        "enum": [
          "evaluated",
          "unavailable",
          "disabled"
        ]
      },
      "modelVersion": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,15}_[a-f0-9]{32,64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "patternMode": {
        "type": "string",
        "enum": [
          "none",
          "shadow",
          "canary"
        ]
      },
      "cached": {
        "type": "boolean"
      },
      "patterns": {
        "maxItems": 6,
        "type": "array",
        "items": {
          "type": "object",
