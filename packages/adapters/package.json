    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "import": "./dist/vercel/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js"
    },
    "./warehouse": {
      "types": "./dist/warehouse.d.ts",
      "import": "./dist/warehouse.js"
    },
    "./operators": {
      "types": "./dist/operators.d.ts",
      "import": "./dist/operators.js"
    },
    "./node/http": {
      "types": "./dist/node/http.d.ts",
      "import": "./dist/node/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aarondovturkel/doorman-core": "workspace:^",
    "@aarondovturkel/doorman-evaluator-cloudflare-jev": "workspace:^",
    "@aarondovturkel/doorman-evaluator-jev": "workspace:^",
    "@aarondovturkel/doorman-storage-d1": "workspace:^",
