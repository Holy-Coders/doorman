  "repository": {
    "type": "git",
    "url": "git+https://github.com/Holy-Coders/doorman.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://doorman.holycoders.io",
  "bugs": {
    "url": "https://github.com/Holy-Coders/doorman/issues"
  },
  "description": "Cloudflare, Node and Vercel adapters for Doorman browser identity and private risk.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
