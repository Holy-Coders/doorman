---
import Logo from "../components/Logo.astro";
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import "../styles/brand.css";
import "../styles/preferences.css";
import "../styles/doorman.css";
import { REPO } from "../content";
interface Props {
  title?: string;
  description?: string;
  docs?: boolean;
  language?: string;
}
const {
  title = "Doorman — Visitor identity, with context.",
  description = "An open-source library for recognizing returning browsers, assessing risk with Jev, and connecting authenticated people and agents. Runs on your server.",
  docs = false,
  language,
} = Astro.props;
const docPath = (slug: string) =>
  `/docs/${language && language !== "typescript" ? language + "/" : ""}${slug}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-doc-language={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      id="theme-icon"
      rel="icon"
      href="/doorman-mark.png"
      type="image/png"
    />
    <script is:inline>
      try {
        const preference = localStorage.getItem("doorman-theme");
        const theme =
          preference === "light" || preference === "dark"
            ? preference
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
        document.getElementById("theme-icon").href =
          theme === "light" ? "/doorman-mark-dark.png" : "/doorman-mark.png";
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
    <meta name="theme-color" content="#080c0c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/social.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[docs && "docs-page"]}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Doorman home">
        <Logo />
        doorman<span class="brand-period">.</span>
      </a>
      <nav aria-label="Main navigation" class="desktop-nav">
        <a href={docPath("introduction")} class:list={[docs && "active"]}>
          Documentation
        </a>
        <a
          href="/playground/"
          class:list={[Astro.url.pathname === "/playground/" && "active"]}
        >
          Playground
        </a>
        <a href={REPO}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <div class="header-actions">
        {docs && (
          <label class="language-control">
            <span class="sr-only">Documentation language</span>
            <select data-language aria-label="Documentation language">
              <option value="typescript" selected={language === "typescript"}>
                TypeScript
              </option>
              <option value="elixir" selected={language === "elixir"}>
                Elixir
              </option>
              <option value="python" selected={language === "python"}>
                Python
              </option>
              <option value="go" selected={language === "go"}>
                Go
              </option>
            </select>
          </label>
        )}
        <button
          class="theme-toggle"
          data-theme-toggle
          aria-label="Switch color theme"
          title="Switch color theme"
        >
          <span aria-hidden="true">◐</span>
          <span data-theme-label>Theme</span>
        </button>
        <button
          class="search-trigger"
          data-search
          aria-label="Search documentation"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="8.5"
              cy="8.5"
              r="5.5"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>Search docs</span>
          <kbd>⌘ K</kbd>
        </button>
        <a class="header-source" href={REPO} aria-label="Source on GitHub">
          Source ↗
        </a>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Open navigation">
          <span></span>
          <span></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <a href={docPath("introduction")}>Documentation</a>
          <a href="/playground/">Playground</a>
          <a href={REPO}>GitHub ↗</a>
          <button data-search>Search docs</button>
        </nav>
      </details>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-brand">
        <a href="/" class="brand">
          <Logo />
          doorman.
        </a>
        <p>
          Visitor identity.
          <br />
          Your server, your rules.
        </p>
        <span>
          Built by <a href="https://github.com/Holy-Coders">Holy Coders</a>
        </span>
      </div>
      <div>
        <span class="footer-heading">Build with Doorman</span>
        <a href={docPath("getting-started")}>Get started</a>
        <a href={docPath("api")}>API reference</a>
        <a href={docPath("agentic-identity")}>Humans, agents & authority</a>
        <a href="/playground/">Interactive labs</a>
      </div>
      <div>
        <span class="footer-heading">Know the details</span>
        <a href={docPath("privacy")}>Privacy & signals</a>
        <a href={docPath("validation")}>Testing & limitations</a>
        <a href={REPO + "/blob/main/LICENSE"}>MIT license</a>
      </div>
      <div class="footer-note">
        <span class="version-dot"></span> Open source. Self-hosted.
        <p>
          Page views collect no browser signals.
          <br />
          The live demo starts only with your consent.
        </p>
        <a href={REPO}>Read the source ↗</a>
        <a href="/doorman-logo.png" download>
          Download the logo ↗
        </a>
      </div>
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="search-top">
        <h2 id="search-title">Search documentation</h2>
        <button data-close-search aria-label="Close search">
          Esc
        </button>
      </div>
      <label class="sr-only" for="docs-search">
        Search query
      </label>
      <input
        id="docs-search"
        type="search"
        placeholder="Try “cookie”, “Cloudflare”, or “retention”…"
        autocomplete="off"
      />
      <div id="search-results" aria-live="polite">
        <p class="search-empty">
          Search setup instructions, examples and the API reference.
        </p>
      </div>
      <div class="search-bottom">
        Local search. No query leaves your browser.
      </div>
    </dialog>
    <script src="../scripts/preferences.ts"></script>
    <script src="../scripts/navigation.ts"></script>
  </body>
</html>
