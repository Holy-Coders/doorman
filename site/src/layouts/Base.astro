---
import Logo from "../components/Logo.astro";
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import { REPO } from "../content";
interface Props {
  title?: string;
  description?: string;
  docs?: boolean;
}
const {
  title = "Janitor — Identity context for the agentic era.",
  description = "First-party browser identity, verified account links, and Jev-powered risk scoring. A small TypeScript library for identity context in the agentic era.",
  docs = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/janitor-logo.png" type="image/png" />
    <meta name="theme-color" content="#10131e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/social.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[docs && "docs-page"]}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Janitor home">
        <Logo />
        janitor<span class="brand-period">.</span>
      </a>
      <nav aria-label="Main navigation" class="desktop-nav">
        <a href="/docs/getting-started/" class:list={[docs && "active"]}>
          Documentation
        </a>
        <a
          href="/playground/"
          class:list={[Astro.url.pathname === "/playground/" && "active"]}
        >
          Playground
        </a>
        <a href={REPO}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <div class="header-actions">
        <button
          class="search-trigger"
          data-search
          aria-label="Search documentation"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="8.5"
              cy="8.5"
              r="5.5"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>Search docs</span>
          <kbd>⌘ K</kbd>
        </button>
        <a class="header-source" href={REPO} aria-label="Source on GitHub">
          Source ↗
        </a>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Open navigation">
          <span></span>
          <span></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <a href="/docs/getting-started/">Documentation</a>
          <a href="/playground/">Playground</a>
          <a href={REPO}>GitHub ↗</a>
          <button data-search>Search docs</button>
        </nav>
      </details>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-brand">
        <a href="/" class="brand">
          <Logo />
          janitor.
        </a>
        <p>
          Identity context for
          <br />
          the agentic era.
        </p>
        <span>
          Built by <a href="https://github.com/Holy-Coders">Holy Coders</a>
        </span>
      </div>
      <div>
        <span class="footer-heading">Build with Janitor</span>
        <a href="/docs/getting-started/">Get started</a>
        <a href="/docs/api/">API reference</a>
        <a href="/docs/agentic-identity/">Humans, agents & authority</a>
        <a href="/playground/">Interactive labs</a>
      </div>
      <div>
        <span class="footer-heading">Know the details</span>
        <a href="/docs/privacy/">Privacy & signals</a>
        <a href="/docs/validation/">Testing & limitations</a>
        <a href={REPO + "/blob/main/LICENSE"}>MIT license</a>
      </div>
      <div class="footer-note">
        <span class="version-dot"></span> Open source. Self-hosted.
        <p>
          This site does not fingerprint you.
          <br />
          The playground uses synthetic data.
        </p>
        <a href={REPO}>Read the source ↗</a>
        <a href="/janitor-logo.png" download>
          Download the logo ↗
        </a>
      </div>
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="search-top">
        <h2 id="search-title">Search documentation</h2>
        <button data-close-search aria-label="Close search">
          Esc
        </button>
      </div>
      <label class="sr-only" for="docs-search">
        Search query
      </label>
      <input
        id="docs-search"
        type="search"
        placeholder="Try “cookie”, “Cloudflare”, or “retention”…"
        autocomplete="off"
      />
      <div id="search-results" aria-live="polite">
        <p class="search-empty">
          Search the API, guides, and implementation notes.
        </p>
      </div>
      <div class="search-bottom">
        Local search. No query leaves your browser.
      </div>
    </dialog>
    <script src="../scripts/navigation.ts"></script>
  </body>
</html>
