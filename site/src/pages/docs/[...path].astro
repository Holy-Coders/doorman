---
import type { GetStaticPaths, MarkdownInstance } from "astro";
import Base from "../../layouts/Base.astro";
import { sections as allSections, REPO } from "../../content";
import { docURL, labels, type Language } from "../../languages";
export const getStaticPaths = (async () => {
  const modules = import.meta.glob<
    MarkdownInstance<{
      title: string;
      description: string;
      source: string;
      language: Language;
      slug: string;
      shared: boolean;
    }>
  >("../../generated/*.md");
  return Promise.all(
    Object.values(modules).map(async (load) => {
      const document = await load();
      const { language, slug } = document.frontmatter;
      return {
        params: {
          path: language === "typescript" ? slug : `${language}/${slug}`,
        },
        props: { document },
      };
    }),
  );
}) satisfies GetStaticPaths;
const { document } = Astro.props;
const { Content, frontmatter } = document;
const { slug, language, shared } = frontmatter;
const sections = allSections
  .map((section) => ({
    ...section,
    pages: section.pages.filter((page) => {
      if (["elixir", "phoenix-example"].includes(page.slug)) return false;
      if (["cloudflare", "nextjs", "node"].includes(page.slug))
        return language === "typescript";
      return true;
    }),
  }))
  .filter((section) => section.pages.length);
const pages = sections.flatMap((section) => section.pages);
const url = (slug: string) => docURL(language, slug);
const index = pages.findIndex((page) => page.slug === slug);
const previous = pages[index - 1];
const next = pages[index + 1];
const headings = document
  .getHeadings()
  .filter((heading) => heading.depth === 2);
---

<Base
  title={frontmatter.title + " — Doorman docs"}
  description={frontmatter.description}
  docs
  language={language}
>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <a class="docs-home" href={url("introduction")}>
        Documentation <span>v0.12.0</span>
      </a>
      {sections.map((section) => (
        <div class="sidebar-section">
          <h2>{section.title}</h2>
          <nav aria-label={section.title}>
            {section.pages.map((page) => (
              <a
                href={url(page.slug)}
                aria-current={page.slug === slug ? "page" : undefined}
              >
                {page.title}
              </a>
            ))}
          </nav>
        </div>
      ))}
      <a class="sidebar-source" href={REPO}>
        Source code ↗
      </a>
    </aside>
    <main id="main" class="docs-main">
      <details class="docs-mobile-nav">
        <summary>Browse documentation</summary>
        <nav>
          {pages.map((page) => (
            <a
              href={url(page.slug)}
              aria-current={page.slug === slug ? "page" : undefined}
            >
              {page.title}
            </a>
          ))}
        </nav>
      </details>
      <div class="doc-breadcrumb">
        Documentation<span>/</span>
        {frontmatter.title}
      </div>
      <h1>{frontmatter.title}</h1>
      <p class="doc-description">{frontmatter.description}</p>
      {shared && language !== "typescript" && (
        <p class="language-context">
          These concepts apply to your {labels[language]} application.{" "}
          {language === "elixir"
            ? "Native setup and API examples are available in your selected language."
            : "Matching and private risk evaluation run in your application-owned TypeScript or Elixir engine; this client handles the HTTP connection."}{" "}
          <a href={url("getting-started")}>See your setup guide.</a> Code
          labeled TypeScript describes the engine configuration.
        </p>
      )}
      <article class="prose">
        <Content />
      </article>
      <div class="doc-edit">
        <a href={REPO + "/blob/main/" + frontmatter.source}>
          View this page on GitHub ↗
        </a>
      </div>
      <nav class="doc-pagination" aria-label="Documentation pages">
        {previous ? (
          <a href={url(previous.slug)}>
            <span>Previous</span>
            <strong>← {previous.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={url(next.slug)}>
            <span>Next</span>
            <strong>{next.title} →</strong>
          </a>
        )}
      </nav>
    </main>
    <aside class="docs-toc">
      <span>On this page</span>
      <nav aria-label="Table of contents">
        {headings.map((heading) => (
          <a href={"#" + heading.slug}>{heading.text}</a>
        ))}
      </nav>
      <div class="toc-help">
        Something unclear?<a href={REPO + "/issues"}>Open an issue ↗</a>
      </div>
    </aside>
  </div>
</Base>
