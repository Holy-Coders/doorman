---
import Base from "../layouts/Base.astro";
import Playground from "../components/Playground.astro";
---

<Base
  title="Identity playground — Janitor"
  description="Explore Janitor's real deterministic matching engine using synthetic browser observations. Nothing is collected or sent."
>
  <main id="main" class="container standalone-lab">
    <div class="page-breadcrumb">
      <a href="/">Janitor</a>
      <span>/</span>Playground
    </div>
    <Playground />
    <div class="experiment-note">
      <h2>An experiment you can inspect.</h2>
      <p>
        The lab runs <code>@janitor/core</code> in your browser against
        in-memory synthetic history. It does not use a real cookie, collect
        browser signals, call Jev, or send observations to a server. The same
        comparison and restoration logic powers the library.
      </p>
      <p>
        Identity confidence is an experimental matching score. It is not
        authentication or proof that two people are the same person.
      </p>
      <a class="text-link" href="/docs/validation/">
        Testing and limitations ↗
      </a>
    </div>
  </main>
</Base>
