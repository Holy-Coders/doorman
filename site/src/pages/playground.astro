---
import Base from "../layouts/Base.astro";
import ActorLab from "../components/ActorLab.astro";
import Playground from "../components/Playground.astro";
---

<Base
  title="Identity playground — Janitor"
  description="Explore Janitor’s real browser matching and delegation checks with synthetic scenarios. Nothing is collected or sent."
>
  <main id="main" class="container standalone-lab">
    <div class="page-breadcrumb">
      <a href="/">Janitor</a>
      <span>/</span>Playground
    </div>
    <ActorLab />
    <Playground />
    <div class="experiment-note">
      <h2>An experiment you can inspect.</h2>
      <p>
        The labs run <code>@janitor/core</code> in your browser against
        synthetic history and simulated credential records. It does not use a
        real cookie, collect browser signals, call Jev, or send observations to
        a server. The same matching and delegation logic powers the library.
      </p>
      <p>
        Identity confidence is an experimental matching score. It is not
        authentication or proof that two people are the same person.
      </p>
      <a class="text-link" href="/docs/validation/">
        Testing and limitations ↗
      </a>
    </div>
  </main>
</Base>
