---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import CodeTabs from "../components/CodeTabs.astro";
import ActorLab from "../components/ActorLab.astro";
import Playground from "../components/Playground.astro";
import { REPO } from "../content";
---

<Base
  title="Doorman — Know who’s behind the request."
  description="Remember browsers, connect verified users and agents, and add context to PostHog or Mixpanel. Open source, with optional Jev scoring."
>
  <main id="main">
    <Hero />
    <p class="container classification-evidence">
      Doorman 0.13 is available on npm and Hex.
      <a href="/docs/languages/">Add it to your app →</a>
    </p>
    <section
      class="integration-section container"
      aria-labelledby="integration-title"
    >
      <div class="integration-copy">
        <h2 id="integration-title">
          A browser client.
          <br />
          An endpoint.
          <br />
          Your database.
        </h2>
        <p>
          Install the packages, connect your database and add one endpoint.
          Doorman creates its tables automatically. No migration commands,
          dashboard or separate service.
        </p>
        <ol class="integration-steps">
          <li>
            <strong>Choose your server</strong>
            <span>Use Node, Next.js, Cloudflare Workers or native Elixir.</span>
          </li>
          <li>
            <strong>Connect storage</strong>
            <span>
              Keep visitor history in your own Postgres or D1 database.
            </span>
          </li>
          <li>
            <strong>Call identify()</strong>
            <span>
              Get a browser ID. Read confidence and risk privately on the
              server.
            </span>
          </li>
        </ol>
        <a class="text-link" href="/docs/identity-context/">
          See the complete setup
        </a>
      </div>
      <CodeTabs />
    </section>

    <section
      class="classification-section container"
      aria-labelledby="classification-title"
    >
      <div class="section-heading">
        <div>
          <span class="section-kicker">Identity meets activity</span>
          <h2 id="classification-title">
            One account.
            <br />
            Different operators.
          </h2>
        </div>
        <div>
          <p>
            A login tells you which account is open. Doorman keeps track of the
            browsers, signed-in people and authenticated agents using it.
          </p>
          <p>
            When you need an estimate, Jev can score whether activity looks
            human, assistant-operated or scripted. A guess stays separate from a
            verified identity.
          </p>
          <a class="text-link" href="/docs/agent-classification/">
            Explore agent classification
          </a>
        </div>
      </div>
      <div class="classification-grid">
        <article>
          <span class="section-kicker">01 / Remember</span>
          <h3>Recognize returning browsers.</h3>
          <p>
            A first-party cookie remembers each browser. A short history helps
            assess possible connections when signals change or the cookie
            disappears.
          </p>
          <a href="/docs/privacy/">What is collected →</a>
        </article>
        <article>
          <span class="section-kicker">02 / Connect</span>
          <h3>Connect users after login.</h3>
          <p>
            Pass the user your server has authenticated. Doorman remembers that
            browser relationship without confusing a shared account with a
            single person.
          </p>
          <a href="/docs/identity-context/">Connect your login →</a>
        </article>
        <article>
          <span class="section-kicker">03 / Understand</span>
          <h3>Your analytics, with context.</h3>
          <p>
            Call identify once through Doorman. PostHog and Mixpanel keep their
            existing funnels and gain browser, session and account properties on
            events.
          </p>
          <a href="/docs/analytics/">Connect your analytics →</a>
        </article>
      </div>
      <p class="classification-evidence">
        Activity labels are experimental. They do not reliably identify an
        agent’s brand or count people sharing one login.{" "}
        <a href="/docs/external-benchmarks/">Read the public-data results →</a>
      </p>
    </section>
    <section
      class="continuity-section container"
      id="browser-demo"
      aria-labelledby="continuity-title"
    >
      <div class="section-heading">
        <h2 id="continuity-title">
          Browsers change.
          <br />
          The connection can stay.
        </h2>
        <div>
          <p>
            Doorman gives a browser a random visitor ID and saves a small
            history of its signals, such as screen size and browser family.
          </p>
          <p>
            A first-party cookie remembers that ID. If it disappears, Doorman
            compares the next visit with past observations. The recommended flow
            keeps a possible match private and gives the browser a fresh ID.
          </p>
          <a class="text-link" href="/docs/matching/">
            Understand browser matching
          </a>
        </div>
      </div>
      <Playground />
    </section>

    <section class="jev-section container" aria-labelledby="jev-title">
      <div class="jev-copy">
        <span class="section-kicker">Optional AI, powered by Jev</span>
        <h2 id="jev-title">
          Small questions.
          <br />
          Useful context.
        </h2>
        <p>
          Jev is an AI model from TypeSafe. It compares browser history and
          scores automation and suspicious signals. With enough activity, it
          also estimates whether a human, assistant or script is operating the
          browser.
        </p>
        <p>
          Use those estimates to inform your own checks, such as when to request
          a CAPTCHA. Doorman returns information; your app decides what happens
          next.
        </p>
        <a class="text-link" href="/docs/evaluators/">
          Meet Jev and the scores
        </a>
        <p>
          Optional cross-device learning compares anonymous visits with earlier
          sessions confirmed by login. A suggestion stays private; only a real
          login connects that person to your analytics.{" "}
          <a href="/docs/learning/">Set up learning →</a>
        </p>
      </div>
      <div class="jev-terminal">
        <div class="terminal-caption">
          <span class="version-dot"></span> Browser matching and risk
        </div>
        <dl>
          <div>
            <dt>
              Does this browser look familiar?<code>sameVisitor</code>
            </dt>
            <dd>
              Compares this visit with recent history, allowing for ordinary
              changes.
            </dd>
          </div>
          <div>
            <dt>
              Does the session look automated?<code>automation</code>
            </dt>
            <dd>Uses available signals and aggregate event counts.</dd>
          </div>
          <div>
            <dt>
              Do the signals look inconsistent?<code>suspicious</code>
            </dt>
            <dd>
              Looks for unusual technical combinations, not a person’s intent.
            </dd>
          </div>
        </dl>
        <p>
          Scores are experimental estimates. Missing signals alone do not mean
          abuse.
        </p>
      </div>
    </section>

    <section class="people-section container" aria-labelledby="people-title">
      <div class="section-heading">
        <h2 id="people-title">
          A browser is one thing.
          <br />A person is another.
        </h2>
        <div>
          <p>
            Two people can share a laptop. One person can use a laptop and a
            phone. An AI assistant can act with that person’s permission.
          </p>
          <p>
            After your app verifies a login or agent credential, Doorman can
            connect those visits to a known identity. It records who is making a
            request and whose account they are using.
          </p>
          <a class="text-link" href="/docs/concepts/">
            Learn the few terms you’ll need
          </a>
        </div>
      </div>
      <ActorLab />
    </section>

    <section
      class="analytics-section container"
      aria-labelledby="analytics-title"
    >
      <div>
        <h2 id="analytics-title">
          Prepare your analytics
          <br />
          for the agentic era.
        </h2>
        <p>
          Keep your analytics. Let Doorman handle identification. Connect it to
          your existing login and logout flow, then keep using PostHog or
          Mixpanel as usual. You do not need to identify through both SDKs.
        </p>
        <p>
          Build funnels for signed-in users, group activity by account, and
          count verified agents separately from people. Send private activity
          estimates from your server when you want to explore uncertain cases.
        </p>
        <a class="text-link" href="/docs/analytics/">
          Connect your analytics
        </a>
        <p>
          Agents can also use your API directly. Add optional
          <a href="/docs/api-activity/">API activity middleware</a> to bring
          those requests into the picture, with private Jev risk assessments.
        </p>
      </div>
      <div
        class="analytics-routing"
        aria-label="Example account with two people and an AI assistant"
      >
        <header>An example workspace</header>
        <div class="analytics-account">
          Design studio <span>2 people · 1 agent</span>
        </div>
        <ul class="analytics-actors">
          <li>
            <b class="person-avatar" aria-hidden="true">
              A
            </b>
            <strong>Alex</strong>
            <span>Person</span>
          </li>
          <li>
            <b class="person-avatar" aria-hidden="true">
              S
            </b>
            <strong>Sam</strong>
            <span>Person</span>
          </li>
          <li>
            <b class="person-avatar agent-avatar" aria-hidden="true">
              ⌘
            </b>
            <strong>Alex’s assistant</strong>
            <span>Agent</span>
          </li>
        </ul>
        <div class="analytics-destinations">
          <span>Send identity events to</span>
          <a href="/docs/analytics/">PostHog</a>
          <a href="/docs/analytics/">Mixpanel</a>
          <a href="/docs/analytics/">Segment</a>
          <a href="/docs/analytics/">Amplitude</a>
          <a href="/docs/analytics/">RudderStack</a>
          <a href="/docs/warehouses/">Snowflake & BigQuery</a>
        </div>
        <p>Illustrative data. Your app supplies verified identities.</p>
      </div>
    </section>

    <section class="privacy-section container" aria-labelledby="privacy-title">
      <div class="privacy-glyph" aria-hidden="true">
        <svg viewBox="0 0 100 110" fill="none">
          <path
            d="M50 8 84 22v29c0 25-17 40-34 51C33 91 16 76 16 51V22L50 8Z"
            stroke="currentColor"
            stroke-width="2"
          />
          <path d="m34 53 11 11 23-27" stroke="currentColor" stroke-width="2" />
        </svg>
      </div>
      <div>
        <h2 id="privacy-title">
          Useful context.
          <br />
          Clear boundaries.
        </h2>
        <p>
          Doorman stores history in your database. If you enable Jev, a compact
          set of signals goes to your chosen AI provider. Doorman respects
          browser privacy restrictions and never captures form values, actual
          keystrokes or browsing history.
        </p>
        <p>
          Risk scores stay on your server by default. Doorman does not replace
          login, prove who is at the keyboard, or automatically block anyone.
        </p>
        <a class="text-link" href="/docs/privacy/">
          See exactly what is collected
        </a>
      </div>
    </section>

    <section class="closing-section container" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">
          Start with
          <br />
          one returning browser.
        </h2>
      </div>
      <div>
        <p>
          Run a local example, see a returning browser, then add private
          activity scores and analytics context as your application needs them.
        </p>
        <a href="/docs/getting-started/" class="button button-primary">
          Get started
        </a>
        <a class="closing-github" href={REPO}>
          Explore the source on GitHub ↗
        </a>
      </div>
    </section>
  </main>
</Base>
