---
import { Code } from "astro:components";
const examples = [
  {
    name: "Browser",
    file: "client.ts",
    code: `import { createDoormanClient } from "@aarondovturkel/doorman-browser";\n\nconst visitor = createDoormanClient({\n  endpoint: "/api/visitor",\n});\n\nconst identity = await visitor.identify();\n\n// { visitorId, sessionId, isReturning }\n// Scores stay on your server.\n// Destroy the client when collection should stop.\nvisitor.destroy();`,
  },
  {
    name: "Cloudflare",
    file: "worker.ts",
    code: `import { createDoorman }\n  from "@aarondovturkel/doorman-adapters/cloudflare";\n\nlet visitor: ReturnType<typeof createDoorman> | undefined;\n\nexport default {\n  async fetch(request, env) {\n    visitor ??= createDoorman({\n      db: env.VISITORS,\n      secret: env.DOORMAN_IDENTITY_SECRET,\n      namespace: "my-app",\n    });\n    return visitor.handle(request);\n  },\n};`,
  },
  {
    name: "Next.js",
    file: "app/api/visitor/route.ts",
    code: `import { createDoorman }\n  from "@aarondovturkel/doorman-adapters/vercel";\n\nconst visitor = createDoorman({\n  db, // Your Postgres pool.\n  secret: process.env.DOORMAN_IDENTITY_SECRET!,\n  namespace: "my-app",\n  evaluator: false, // Add Jev later.\n});\n\nexport async function POST(request: Request) {\n  return visitor.handle(request);\n}`,
  },
  {
    name: "Node",
    file: "server.ts",
    code: `import { createDoorman }\n  from "@aarondovturkel/doorman-adapters/node";\n\nconst visitor = createDoorman({\n  db, // Any compatible Postgres pool.\n  secret: process.env.DOORMAN_IDENTITY_SECRET!,\n  namespace: "my-app",\n  evaluator: false, // Add Jev later.\n});\n\n// Standard Web Request / Response.\nconst response = await visitor.handle(request);\n\n// Maintenance runs on your schedule.\nawait visitor.cleanup();`,
  },
  {
    name: "Phoenix",
    file: "visitor_controller.ex",
    code: `# Native Elixir · your existing Ecto repo
doorman = Doorman.new(
  repo: MyApp.Repo,
  secret: System.fetch_env!("DOORMAN_IDENTITY_SECRET"),
  namespace: "my-app"
)

# Your Phoenix controller
Doorman.handle(conn, doorman, %{
  auth: %{user_id: to_string(current_user.id)}
})
# Private context is in conn.assigns.`,
  },
  {
    name: "Analytics",
    file: "identity.ts",
    code: `import { createDoormanClient } from "@aarondovturkel/doorman-browser";

const doorman = createDoormanClient({
  endpoint: "/api/visitor",
  analytics: { posthog, mixpanel }, // Initialized SDKs.
});

await doorman.identify();
// After your app verifies login:
await doorman.identify({ userId: user.id, accountId: account.id });
await doorman.update({ plan: "team" });
await doorman.track("Project created");
// On logout:
await doorman.reset();`,
  },
];
---

<div class="code-demo" data-code-tabs>
  <div class="code-tabs" role="tablist" aria-label="Integration examples">
    {examples.map((example, i) => (
      <button
        role="tab"
        id={"tab-" + i}
        aria-controls={"code-" + i}
        aria-selected={i === 0}
        tabindex={i === 0 ? 0 : -1}
        data-tab={i}
      >
        {example.name}
      </button>
    ))}
  </div>
  {examples.map((example, i) => (
    <div
      role="tabpanel"
      id={"code-" + i}
      aria-labelledby={"tab-" + i}
      hidden={i !== 0}
      tabindex="0"
    >
      <div class="code-file">
        <span>{example.file}</span>
        <button data-copy aria-label={"Copy " + example.name + " example"}>
          Copy code
        </button>
      </div>
      <Code
        code={example.code}
        lang={example.name === "Phoenix" ? "elixir" : "ts"}
        themes={{ light: "github-light", dark: "github-dark" }}
        defaultColor={false}
      />
    </div>
  ))}
  <div class="code-demo-footer">
    <span class="version-dot"></span>0.13 API excerpts. See the setup guide for
    the complete app.
  </div>
</div>
