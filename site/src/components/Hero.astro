<section class="identity-hero" aria-labelledby="hero-title" data-motion-scene>
  <div class="hero-film" aria-hidden="true">
    <img
      class="hero-poster"
      src="/media/continuity-poster.webp"
      width="1920"
      height="1080"
      alt=""
      fetchpriority="high"
    />
    <video
      data-hero-video
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"
    >
      <source data-src="/media/continuity.webm" type="video/webm" />
      <source data-src="/media/continuity.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="container hero-composition">
    <div class="hero-copy">
      <a class="hero-announcement" href="/docs/evaluators/">
        <span class="version-dot"></span> Identity intelligence, powered by Jev{" "}
        <span aria-hidden="true">↗</span>
      </a>
      <h1 id="hero-title">
        Know who’s
        <br />
        behind the
        <br />
        request.
      </h1>
      <p class="hero-description">
        A returning browser. A verified person. An agent acting on their behalf.
        Give your application the context to tell them apart.
      </p>
      <div class="hero-actions">
        <a href="/docs/getting-started/" class="button button-primary">
          Start building <span aria-hidden="true">↗</span>
        </a>
        <a href="#actor-lab" class="button button-subtle">
          Try the actor lab <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-footnote">
        Open source <span aria-hidden="true">/</span> Your database{" "}
        <span aria-hidden="true">/</span> Your rules
      </p>
    </div>
    <div class="hero-film-note">
      <span class="film-label">
        <span class="version-dot"></span> Signals change. Context stays.
      </span>
      <button
        class="motion-toggle"
        data-motion-toggle
        aria-pressed="false"
        hidden
      >
        Play motion
      </button>
    </div>
  </div>
  <div class="hero-index container">
    <a href="/docs/matching/">
      <span class="index-number">01 /</span>
      <span>Browser continuity</span>
      <span aria-hidden="true">↗</span>
    </a>
    <a href="/docs/agentic-identity/">
      <span class="index-number">02 /</span>
      <span>Humans & agents</span>
      <span aria-hidden="true">↗</span>
    </a>
    <a href="/docs/trust/">
      <span class="index-number">03 /</span>
      <span>Private risk signals</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
