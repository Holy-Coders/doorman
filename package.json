{
  "name": "janitor-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "vitest run",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.tests.json && pnpm -r --filter \"./examples/**\" run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "pnpm build && pnpm --filter @janitor/example-node build && playwright test",
    "pack:all": "pnpm build && node scripts/pack.mjs",
    "site:dev": "pnpm --filter @janitor/site dev",
    "site:build": "pnpm --filter @janitor/core build && pnpm --filter @janitor/site build",
    "site:check": "pnpm --filter @janitor/site typecheck",
    "site:test": "pnpm site:build && playwright test --config site/playwright.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@eslint/js": "^9.0.0",
    "@janitor/adapters": "workspace:^",
    "@janitor/browser": "workspace:^",
    "@janitor/core": "workspace:^",
    "@janitor/evaluator-cloudflare-jev": "workspace:^",
    "@janitor/evaluator-jev": "workspace:^",
    "@janitor/storage-d1": "workspace:^",
    "@janitor/storage-postgres": "workspace:^",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "miniflare": "^4.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
